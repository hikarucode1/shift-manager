# ---- Supabase ----
# プロジェクト URL（Supabase ダッシュボード > Project Settings > API > "Project URL"）
# project-ref はランダムな英小文字列 (例: uguacvaiamvtgtodkgtm)。
# ⚠️ 末尾の "/rest/v1/" は付けないこと。ベース URL のみ。
#    付けてしまうと Auth リクエストが PostgREST に流れて 404 (PGRST125) で死にます。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon public key (Project Settings > API > "Project API keys" > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service role key (Project Settings > API > "Project API keys" > service_role)
# ⚠️ サーバー専用。絶対にクライアントへ出さない。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Drizzle / Postgres ----
# Project Settings > Database > Connection string > "Transaction pooler" タブの URI
# ⚠️ ポート 6543 (Transaction pooler) を使うこと。5432 だと postgres-js の prepare 設定と衝突する。
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# migration 専用の direct connection (ポート 5432 / Session pooler)。
# `npm run db:migrate` はこの DIRECT_URL を優先して使う (無ければ DATABASE_URL)。
# transaction pooler(6543)経由だと migrate が half-applied で失敗するため
# (docs/migration-policy.md 参照)。アプリ実行時は DATABASE_URL(6543)のまま。
# 例: postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ---- App ----
# タイムゾーン: ローカル開発の利便のためのみ (任意)。
# アプリは OS の TZ に依存しない (週計算は固定 +9h / toLocale* は timeZone 明示)。
# ⚠️ Vercel では予約変数のため設定不可。本番では未設定で問題なし。
TZ=Asia/Tokyo
